---
import GameTile from './GameTile.astro';
const { games, mosaic = false, rail = false, hubHero = false, badgeContext = null, heroRibbon = null } = Astro.props;

/* Featured-mosaic pattern (v8): within every run of 12 tiles, tiles 0 and 5
   span 2x2. With grid-auto-flow:dense that supercell packs perfectly.
   V10 hub hero: if hubHero is true, tile 0 is always a 2x2 hero tile!
   D5: no reserved mosaic rows when item count is below the pattern (< 6 items).
   Shelves with 1-2 items render as a compact row at tile size. */
const isBig = (i: number) => {
  if (hubHero && i === 0) return true;
  if (!mosaic || games.length < 6) return false;
  return (i % 12 === 0 || i % 12 === 5);
};
const isSparse = games.length <= 2;
---

<div class:list={['tiles', { mosaic: (mosaic || hubHero) && games.length >= 6 }, { rail }, { 'is-sparse': isSparse }]}>
  {games.map((g, i) => (
    <GameTile
      game={g}
      big={isBig(i)}
      hero={hubHero && i === 0}
      heroRibbon={hubHero && i === 0 ? heroRibbon : null}
      badge={(!mosaic && !hubHero) || isBig(i)}
      badgeContext={badgeContext}
      eager={i < 2}
    />
  ))}
</div>
