---
import { gameUrl, MONETIZED_SOURCES } from '../lib/games.mjs';
const { game, big = false, eager = false, badge = true } = Astro.props;
/* Badges are sparse by design (Poki shows an occasional corner chip, not
   one per tile): the grid suppresses them on small mosaic tiles, where a
   ribbon on every tile would be noise. */
const ribbon = badge ? (game.featured ? 'hot' : MONETIZED_SOURCES.has(game.source) ? 'new' : null) : null;
---

{/* Poki-system tile (v8): a square of the game's OWN feed art, full-bleed,
    nothing under it. The title lives on the link (aria-label + title attr)
    and, on hover-capable devices only, as a pill fading in over the art's
    bottom edge — Poki's label discipline. No chips, no meta rows, no
    generated art: covers are originals (the standing rule). */}
<a
  class:list={['tile', { big }]}
  href={gameUrl(game)}
  title={game.title}
  aria-label={`Play ${game.title} online`}
>
  <img
    class="tile-img"
    src={game.thumb}
    alt=""
    loading={eager ? 'eager' : 'lazy'}
    width="512"
    height="384"
  />
  {
    ribbon && (
      <span class:list={['ribbon', ribbon]} aria-hidden="true">
        {ribbon === 'hot' ? (
          <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M12.6 1.8c.5 3.9-2.2 5.4-3.4 7.2-.8 1.3-.9 2.7.1 3.9.8.9 2.2 1 3.1.2.8-.7.8-1.9.5-3 1.6 1 3.1 2.8 3.1 5a5.6 5.6 0 0 1-11.2 0c0-1.9 1-3.4 2-4.9C7.9 6.9 10.4 3.6 12.6 1.8z"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M12 1.5l2.6 6.9 7.4.5-5.7 4.7 1.8 7.1L12 16.2l-6.1 4.5 1.8-7.1L2 8.9l7.4-.5z"/></svg>
        )}
        {ribbon.toUpperCase()}
      </span>
    )
  }
  <span class="tile-cap" aria-hidden="true">{game.title}</span>
</a>
