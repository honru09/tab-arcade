---
import { gameUrl } from '../lib/games.mjs';
import { artUrl, animUrl, accentFor } from '../lib/art.mjs';
const { game, index = 0 } = Astro.props;
const art = artUrl(game);
const anim = animUrl(game);
const accent = accentFor(game);
const cat = game.categories[0] || 'Game';
const tag = (game.tags || []).find((t) => t.toLowerCase() !== cat.toLowerCase());
const ribbon = game.featured ? 'hot' : game.source === 'gm' ? 'new' : null;
---

<a
  class:list={['card', { 'has-pop': !!art, 'has-anim': !!anim }]}
  href={gameUrl(game)}
  style={`--acc:${accent};--d:${(index % 10) * 45}ms`}
  data-tilt
>
  <span class="card-art">
    <span class="thumb-wrap">
      <img
        class="thumb"
        src={game.thumb}
        alt={`Play ${game.title} online`}
        loading="lazy"
        width="512"
        height="384"
      />
      {
        anim && (
          <img
            class="anim"
            data-anim={anim}
            src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="480"
            height="360"
          />
        )
      }
      <span class="fx" aria-hidden="true"></span>
      {
        ribbon && (
          <span class:list={['ribbon', ribbon]} aria-hidden="true">
            {ribbon === 'hot' ? (
              <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M12.6 1.8c.5 3.9-2.2 5.4-3.4 7.2-.8 1.3-.9 2.7.1 3.9.8.9 2.2 1 3.1.2.8-.7.8-1.9.5-3 1.6 1 3.1 2.8 3.1 5a5.6 5.6 0 0 1-11.2 0c0-1.9 1-3.4 2-4.9C7.9 6.9 10.4 3.6 12.6 1.8z"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M12 1.5l2.6 6.9 7.4.5-5.7 4.7 1.8 7.1L12 16.2l-6.1 4.5 1.8-7.1L2 8.9l7.4-.5z"/></svg>
            )}
            {ribbon.toUpperCase()}
          </span>
        )
      }
    </span>
    {art && <img class="pop" src={art} alt="" aria-hidden="true" loading="lazy" width="560" height="560" />}
    <span class="play-badge" aria-hidden="true">▶</span>
  </span>
  <span class="card-meta">
    <span class="t">{game.title}</span>
    <span class="chips">
      <span class="chip">{cat}</span>
      {tag && <span class="chip alt">{tag}</span>}
      {game.mobile && <span class="chip alt">📱 Touch</span>}
    </span>
  </span>
</a>
