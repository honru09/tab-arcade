---
import Base from '../../layouts/Base.astro';
import GameGrid from '../../components/GameGrid.astro';
import { allGames, relatedGames, gameFaqs, gameUrl, u } from '../../lib/games.mjs';
import { artUrl, accentFor } from '../../lib/art.mjs';

export function getStaticPaths() {
  return allGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const related = relatedGames(game, 6);
const faqs = gameFaqs(game);
const dot = game.description.indexOf('. ');
const teaser = dot > 40 ? game.description.slice(0, dot + 1) : game.description.slice(0, 150);
const ins = (game.instructions || '').toLowerCase();
const ctrl = [];
if (/arrow|wasd|keyboard/.test(ins)) ctrl.push('⌨️ Keyboard');
if (/mouse|click/.test(ins)) ctrl.push('🖱️ Mouse');
if (/space/.test(ins)) ctrl.push('␣ Spacebar');
if (/touch|tap|swipe/.test(ins) || game.mobile) ctrl.push('👆 Touch');
if (!ctrl.length) ctrl.push('🎮 On-screen controls');
const ratio = Math.round((game.height / game.width) * 1000) / 10;
const art = artUrl(game);
const accent = accentFor(game);

const title = `Play ${game.title} Online Free — No Download | TabArcade`;
const description = game.description.slice(0, 158);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.description,
    url: game.pageUrl,
    image: game.thumb,
    genre: game.categories,
    gamePlatform: ['Web Browser', 'Chromebook', 'Mobile'],
    applicationCategory: 'Game',
    operatingSystem: 'Any (browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TabArcade', item: 'https://tabarcade.online/' },
      { '@type': 'ListItem', position: 2, name: game.categories[0] || 'Games', item: 'https://tabarcade.online/unblocked-games-for-school/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: game.pageUrl },
    ],
  },
];
---

<Base title={title} description={description} canonical={game.pageUrl} ogImage={game.thumb} jsonLd={jsonLd}>
  <div class="crumbs">
    <a href={u()}>Home</a> › <a href={u('unblocked-games-for-school/')}>Games</a> › {game.title}
  </div>

  <h1>{game.title}</h1>
  <p class="lede">
    Play {game.title} free in your browser — no download, no sign-up. Works on Chromebooks, laptops and phones.
  </p>

  <div class="stage" style={`--acc:${accent}`}>
    {art && <img class="stage-art" src={art} alt="" aria-hidden="true" width="560" height="560" loading="lazy" />}
    <div class="player-shell" id="playerShell" style={`aspect-ratio: ${game.width} / ${game.height}; max-height: 78vh;`}>
      <iframe
        src={game.embedUrl}
        title={`Play ${game.title}`}
        loading="lazy"
        allow="fullscreen; autoplay; gamepad"
        allowfullscreen
        scrolling="no"
      ></iframe>
    </div>
  </div>
  <div class="player-bar">
    <span class="chips" style="margin-top:0">
      {game.categories.map((c) => <span class="chip">{c}</span>)}
    </span>
    <button class="btn fs-btn" type="button">⛶ Fullscreen</button>
  </div>

  <div class="sticky-play">
    <span class="sp-t">🎮 {game.title}</span>
    <a class="btn ghost" href="#more-like-this" style="padding:9px 14px">More games</a>
    <button class="btn fs-btn" type="button" style="padding:9px 16px">⛶ Play big</button>
  </div>
  <script>
    document.body.classList.add('has-sticky');
    const goFs = () => {
      const el = document.getElementById('playerShell');
      if (el?.requestFullscreen) el.requestFullscreen();
      else el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    document.querySelectorAll('.fs-btn').forEach((b) => b.addEventListener('click', goFs));
  </script>

  <p class="teaser"><b>{game.title}</b> — {teaser}</p>

  <div class="drawers two" style={`--acc:${accent}`}>
    <div class="drawer">
      <button class="drawer-head" type="button" aria-expanded="false">
        <span>📖 About this game</span>
        <span class="chev" aria-hidden="true">▾</span>
      </button>
      <div class="drawer-body">
        <div class="drawer-inner">
          <div class="pad">
            <p>{game.description}</p>
            {
              game.tags.length > 0 && (
                <span class="chips">
                  {game.tags.map((t) => (
                    <span class="chip alt">{t}</span>
                  ))}
                </span>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <div class="drawer">
      <button class="drawer-head" type="button" aria-expanded="false">
        <span>🕹️ How to play</span>
        <span class="ctrl-chips chips" style="margin-top:0">
          {ctrl.map((c) => <span class="chip">{c}</span>)}
        </span>
        <span class="chev" aria-hidden="true">▾</span>
      </button>
      <div class="drawer-body">
        <div class="drawer-inner">
          <div class="pad">
            <p>{game.instructions || `Open the game above and follow the on-screen prompts. ${game.title} is designed to be picked up in seconds — most browser games use the arrow keys, WASD, the mouse, or touch controls.`}</p>
            <p>
              Tip: click the Fullscreen button for the biggest play area, especially on a Chromebook.
              If the game seems stuck loading, wait a few seconds and refresh once — browser games stream
              their assets on first load.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h2>{game.title} FAQ</h2>
  <div class="faq">
    {
      faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>

  <h2 id="more-like-this">Games Like {game.title}</h2>
  <GameGrid games={related} rail />
</Base>
