---
import Base from '../../layouts/Base.astro';
import GameGrid from '../../components/GameGrid.astro';
import { allGames, relatedGames, gameFaqs, gameUrl, u } from '../../lib/games.mjs';

export function getStaticPaths() {
  return allGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const related = relatedGames(game, 6);
const faqs = gameFaqs(game);
const ratio = Math.round((game.height / game.width) * 1000) / 10;

const title = `Play ${game.title} Online Free — No Download | TabArcade`;
const description = game.description.slice(0, 158);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.description,
    url: game.pageUrl,
    image: game.thumb,
    genre: game.categories,
    gamePlatform: ['Web Browser', 'Chromebook', 'Mobile'],
    applicationCategory: 'Game',
    operatingSystem: 'Any (browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TabArcade', item: 'https://honru09.github.io/tab-arcade/' },
      { '@type': 'ListItem', position: 2, name: game.categories[0] || 'Games', item: 'https://honru09.github.io/tab-arcade/unblocked-games-for-school/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: game.pageUrl },
    ],
  },
];
---

<Base title={title} description={description} canonical={game.pageUrl} ogImage={game.thumb} jsonLd={jsonLd}>
  <div class="crumbs">
    <a href={u()}>Home</a> › <a href={u('unblocked-games-for-school/')}>Games</a> › {game.title}
  </div>

  <h1>{game.title}</h1>
  <p class="lede">
    Play {game.title} free in your browser — no download, no sign-up. Works on Chromebooks, laptops and phones.
  </p>

  <div class="player-shell" id="playerShell" style={`aspect-ratio: ${game.width} / ${game.height}; max-height: 78vh;`}>
    <iframe
      src={game.embedUrl}
      title={`Play ${game.title}`}
      loading="lazy"
      allow="fullscreen; autoplay; gamepad"
      allowfullscreen
      scrolling="no"
    ></iframe>
  </div>
  <div class="player-bar">
    <span>
      {game.categories.map((c) => <span class="chip alt">{c}</span>)}
    </span>
    <button class="btn" id="fsBtn" type="button">⛶ Fullscreen</button>
  </div>
  <script>
    document.getElementById('fsBtn')?.addEventListener('click', () => {
      const el = document.getElementById('playerShell');
      if (el?.requestFullscreen) el.requestFullscreen();
    });
  </script>

  <h2>About {game.title}</h2>
  <div class="prose">
    <p>{game.description}</p>
    {
      game.tags.length > 0 && (
        <p>
          Tags: {game.tags.join(' · ')}
        </p>
      )
    }
  </div>

  <h2>How to Play {game.title}</h2>
  <div class="prose">
    <p>{game.instructions || `Open the game above and follow the on-screen prompts. ${game.title} is designed to be picked up in seconds — most browser games use the arrow keys, WASD, the mouse, or touch controls.`}</p>
    <p>
      Tip: click the Fullscreen button for the biggest play area, especially on a Chromebook.
      If the game seems stuck loading, wait a few seconds and refresh once — browser games stream
      their assets on first load.
    </p>
  </div>

  <h2>{game.title} FAQ</h2>
  <div class="faq">
    {
      faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>

  <h2>Games Like {game.title}</h2>
  <GameGrid games={related} />
</Base>
