---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { shelves, allGames, gameUrl, u, getGameOfTheDay } from '../lib/games.mjs';

const gotd = getGameOfTheDay();
const featured = shelves.featured();
const driving = shelves.driving().slice(0, 10);
const running = shelves.running().slice(0, 10);
const math = shelves.math().slice(0, 10);
const io = shelves.io().slice(0, 10);
const twoPlayer = shelves.twoPlayer().slice(0, 10);
const breaks = shelves.breaks().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TabArcade',
  url: 'https://tabarcade.online/',
  description:
    'Free browser games with no downloads or sign-ups. Racing, running, puzzle, math and .io games that work on Chromebooks, laptops and phones.',
  publisher: { '@type': 'Organization', name: 'TabArcade', url: 'https://tabarcade.online/' },
};
---

<Base
  title="TabArcade — Free Browser Games, No Downloads | Play on Chromebook"
  description="Play free browser games instantly: drifting, racing, endless runners, math puzzles and .io games. No downloads, no sign-ups — works on Chromebooks, laptops and phones."
  jsonLd={jsonLd}
>
  <div class="title-strip">
    <h1>Free Browser Games — No Downloads, Just Play</h1>
  </div>

  {/* Client-side Jump back in rail (spec §2.1) */}
  <div id="jumpBackInRail"></div>

  {/* Featured shelf with restyled Game of the Day hero (spec §3.3) */}
  <section class="shelf" id="popular">
    <div class="gotd-shelf">
      <a href={gameUrl(gotd)} class="gotd-hero" aria-label={`Play ${gotd.title}`}>
        <img src={gotd.thumb} alt="" width="1024" height="576" loading="eager" class="hero-cover" />
        <span class="hero-shade" aria-hidden="true"></span>
        <div class="hero-info">
          <div class="hero-title">{gotd.title}</div>
          <span class="hero-play-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M8 5v14l11-7z"></path>
            </svg>
            Play
          </span>
        </div>
      </a>
    </div>

    <h2>🔥 Popular Games</h2>
    <GameGrid games={featured} mosaic />
  </section>

  <div class="band band-alt">
    <h2>🏎️ Driving &amp; Drifting <a class="more" href={u('driving-games/')}>all driving games →</a></h2>
    <GameGrid games={driving} />
  </div>

  <section class="shelf">
    <h2>🏃 Running Games <a class="more" href={u('running-games/')}>all running games →</a></h2>
    <GameGrid games={running} />
  </section>

  <div class="band band-alt">
    <h2>🧮 Math &amp; Puzzle Games <a class="more" href={u('math-games/')}>all math games →</a></h2>
    <GameGrid games={math} />
  </div>

  <section class="shelf">
    <h2>🌐 .io Games <a class="more" href={u('io-games/')}>all .io games →</a></h2>
    <GameGrid games={io} />
  </section>

  <div class="band band-alt">
    <h2>👥 2 Player Games <a class="more" href={u('2-player-games/')}>all 2 player games →</a></h2>
    <GameGrid games={twoPlayer} />
  </div>

  <section class="shelf" id="new-games">
    <h2>⚡ Quick Break Games <a class="more" href={u('classroom-games/')}>classroom games →</a></h2>
    <GameGrid games={breaks} />
  </section>

  {/* Why TabArcade prose relocated below all shelves per Section 6 */}
  <div class="expandable" style="margin-top:36px">
    <h2>Why TabArcade?</h2>
    <div class="prose">
      <p class="lede">
        TabArcade is a shelf of free games that open right in your browser tab. No downloads, no installs,
        no sign-ups — and yes, they work on school Chromebooks, laptops and phones. Pick a game and you are
        playing in seconds.
      </p>
      <p>
        Every game on TabArcade runs as a web page, so there is nothing to install, nothing to download,
        and nothing to update. Rounds are short by design: an endless-runner attempt, a drift run or a puzzle
        fits a lunch break or the last minutes of a free period, and the fullscreen button on each game
        page gives you the whole screen when you want it. In a hurry? The
        <a href={u('all-games/')}>all games A–Z list</a> puts every title on one page.
      </p>
      <div class="exp-rest">
        <div class="exp-clip">
          <p>
            Browse the shelves above, or start from our hand-picked
            <a href={u('best-unblocked-games/')}>best unblocked games</a> list, the
            <a href={u('classroom-games/')}>classroom games</a> shelf, or the
            <a href={u('unblocked-games-for-chromebook/')}>Chromebook games</a> hub.
          </p>
        </div>
      </div>
    </div>
    <button class="exp-btn" type="button" aria-expanded="false" data-more="Read more ▾" data-less="Show less ▴">Read more ▾</button>
  </div>

  <script>
    (() => {
      // Jump back in rail (spec §2.1)
      try {
        const raw = localStorage.getItem('ta-recent');
        const list = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(list) || !list.length) return;
        const container = document.getElementById('jumpBackInRail');
        if (!container) return;
        const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const isSparse = list.length <= 2;
        const shelf = document.createElement('section');
        shelf.className = `shelf jump-back-in-shelf${isSparse ? ' is-sparse' : ''}`;
        shelf.innerHTML = `
          <h2>🕒 Jump Back In</h2>
          <div class="tiles rail${isSparse ? ' is-sparse' : ''}">
            ${list.slice(0, 8).map((item) => `
              <a class="tile" href="${esc(item.url)}" title="${esc(item.title)}" aria-label="Play ${esc(item.title)} online">
                <img class="tile-img" src="${esc(item.thumb)}" alt="" loading="lazy" width="512" height="384" />
              </a>
            `).join('')}
          </div>
        `;
        container.appendChild(shelf);
      } catch (e) {}
    })();
  </script>
</Base>
