---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { shelves, allGames, gameUrl, u } from '../lib/games.mjs';
import { artUrl, accentFor } from '../lib/art.mjs';

/* Game of the Day pool: every game with pop-out key art. The client picks
   one deterministically by date, so all visitors see the same pick. */
const gotdPool = allGames
  .filter((g) => artUrl(g))
  .map((g) => {
    const dot = g.description.indexOf('. ');
    return {
      title: g.title,
      url: gameUrl(g),
      art: artUrl(g),
      accent: accentFor(g),
      blurb: (dot > 40 ? g.description.slice(0, dot + 1) : g.description.slice(0, 140)).slice(0, 150),
    };
  });

const featured = shelves.featured();
const driving = shelves.driving().slice(0, 10);
const running = shelves.running().slice(0, 10);
const math = shelves.math().slice(0, 10);
const io = shelves.io().slice(0, 10);
const sports = shelves.sports().slice(0, 10);

/* Hero spotlight: games with pop-out key art, spread across categories. */
const bySlug = new Map(allGames.map((g) => [g.slug, g]));
const spotlight = [
  'snow-rider-neo',
  'car-eats-car-3d',
  'geometry-vibes-2-online',
  'tennis-masters-2026',
  'typeblade-shadow-dojo',
]
  .map((s) => bySlug.get(s))
  .filter((g) => g && artUrl(g));

const trending = shelves.popular().slice(0, 14);
const catCount = new Set(allGames.flatMap((g) => g.categories)).size;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TabArcade',
  url: 'https://tabarcade.online/',
  description:
    'Free browser games with no downloads or sign-ups. Racing, running, puzzle, math and .io games that work on Chromebooks, laptops and phones.',
  publisher: { '@type': 'Organization', name: 'TabArcade', url: 'https://tabarcade.online/' },
};
---

<Base
  title="TabArcade — Free Browser Games, No Downloads | Play on Chromebook"
  description="Play free browser games instantly: drifting, racing, endless runners, math puzzles and .io games. No downloads, no sign-ups — works on Chromebooks, laptops and phones."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div>
      <h1>Free Browser Games — No Downloads, Just Play</h1>
      <p class="lede">
        TabArcade is a shelf of free games that open right in your browser tab. No downloads, no installs,
        no sign-ups — and yes, they work on school Chromebooks, laptops and phones. Pick a game and you are
        playing in seconds.
      </p>
      <div class="hero-ctas">
        <a class="btn" href={u('best-unblocked-games/')}>▶ Play the Best Games</a>
        <a class="btn ghost" href={u('unblocked-games-for-school/')}>Browse All Games</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><b>{allGames.length}</b><span>Free games</span></div>
        <div class="stat"><b>{catCount}</b><span>Categories</span></div>
        <div class="stat"><b>0</b><span>Downloads</span></div>
        <div class="stat"><b>100%</b><span>Browser-based</span></div>
      </div>
    </div>
    <div>
      <div class="hero-visual" id="spotBox">
        {
          spotlight.map((g, i) => (
            <a
              class:list={['spot', { active: i === 0 }]}
              href={gameUrl(g)}
              aria-hidden={i !== 0}
              tabindex={i === 0 ? undefined : -1}
              style={`--acc:${accentFor(g)}`}
            >
              <img
                src={i === 0 ? artUrl(g) : undefined}
                data-src={i === 0 ? undefined : artUrl(g)}
                alt={`Play ${g.title} online`}
                width="560"
                height="560"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
              <span class="spot-name">▶ {g.title}</span>
            </a>
          ))
        }
      </div>
      <div class="spot-dots" id="spotDots">
        {spotlight.map((g, i) => <button type="button" class={i === 0 ? 'on' : ''} aria-label={`Show ${g.title}`} />)}
      </div>
    </div>
  </section>

  <div class="marquee-band">
    <div class="marquee-label">🔥 Trending now</div>
    <div class="marquee">
      <div class="marquee-track">
        {
          [...trending, ...trending].map((g, i) => (
            <a class="mq-item" href={gameUrl(g)} aria-hidden={i >= trending.length}>
              <img src={g.thumb} alt="" loading="lazy" width="68" height="68" />
              {g.title}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <h2>⭐ Featured Games</h2>
  <GameGrid games={featured} />

  <h2>🏎️ Driving &amp; Drifting <a class="more" href={u('driving-games/')}>all driving games →</a></h2>
  <GameGrid games={driving} />

  <h2>🏃 Running Games <a class="more" href={u('running-games/')}>all running games →</a></h2>
  <GameGrid games={running} />

  <h2>🧮 Math &amp; Puzzle Games <a class="more" href={u('math-games/')}>all math games →</a></h2>
  <GameGrid games={math} />

  <h2>🌐 .io Games <a class="more" href={u('io-games/')}>all .io games →</a></h2>
  <GameGrid games={io} />

  <h2>⚽ Sports Games <a class="more" href={u('2-player-games/')}>2 player games →</a></h2>
  <GameGrid games={sports} />

  <h2>Why TabArcade?</h2>
  <div class="expandable">
    <div class="prose">
      <p>
        School laptops and Chromebooks block almost every way of installing a game — but they cannot block
        the web itself. Every game on TabArcade runs as a web page, so there is nothing to install and
        nothing to update. Rounds are short by design: an endless-runner attempt, a drift run or a puzzle
        fits a lunch break or the last minutes of a free period, and the fullscreen button on each game
        page gives you the whole screen when you want it. In a hurry? The
        <a href={u('all-games/')}>all games A–Z list</a> puts every title on one page.
      </p>
      <div class="exp-rest">
        <div class="exp-clip">
          <p>
            Browse the shelves above, or start from our hand-picked
            <a href={u('best-unblocked-games/')}>best unblocked games</a> list, the
            <a href={u('classroom-games/')}>classroom games</a> shelf, or the
            <a href={u('unblocked-games-for-chromebook/')}>Chromebook games</a> hub.
          </p>
        </div>
      </div>
    </div>
    <button class="exp-btn" type="button" aria-expanded="false" data-more="Read more ▾" data-less="Show less ▴">Read more ▾</button>
  </div>

  <div class="gotd" id="gotd" role="dialog" aria-modal="true" aria-label="Game of the day" hidden>
    <div class="gotd-card" id="gotdCard">
      <button class="gotd-close" id="gotdClose" type="button" aria-label="Close">✕</button>
      <img class="gotd-art" id="gotdArt" alt="" width="560" height="560" />
      <span class="kicker">⭐ GAME OF THE DAY</span>
      <h3 id="gotdTitle"></h3>
      <p id="gotdBlurb"></p>
      <a class="btn" id="gotdPlay" href="#">▶ Play Now — Free</a>
    </div>
  </div>
  <script define:vars={{ gotdPool }}>
    // Game of the Day: same pick for everyone on a given date, shown once
    // per session, dismissible via button / backdrop / Escape.
    (() => {
      if (!gotdPool.length) return;
      const today = new Date().toDateString();
      let seen = null;
      try {
        seen = sessionStorage.getItem('ta-gotd');
      } catch (e) { /* private mode */ }
      if (seen === today) return;
      const pick = gotdPool[Math.floor(Date.now() / 86400000) % gotdPool.length];
      const box = document.getElementById('gotd');
      document.getElementById('gotdArt').src = pick.art;
      document.getElementById('gotdTitle').textContent = pick.title;
      document.getElementById('gotdBlurb').textContent = pick.blurb;
      document.getElementById('gotdPlay').href = pick.url;
      document.getElementById('gotdCard').style.setProperty('--acc', pick.accent);
      let lastFocus = null;
      const close = () => {
        box.classList.remove('show');
        window.setTimeout(() => box.setAttribute('hidden', ''), 380);
        document.removeEventListener('keydown', onKey);
        if (lastFocus && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
      };
      const onKey = (e) => {
        if (e.key === 'Escape') close();
      };
      document.getElementById('gotdClose').addEventListener('click', close);
      document.getElementById('gotdPlay').addEventListener('click', close);
      box.addEventListener('click', (e) => {
        if (e.target === box) close();
      });
      document.addEventListener('keydown', onKey);
      window.setTimeout(() => {
        box.removeAttribute('hidden');
        lastFocus = document.activeElement;
        requestAnimationFrame(() => {
          box.classList.add('show');
          // Move focus into the dialog so keyboard/screen-reader users
          // land on it (and Escape/close returns focus to the page).
          document.getElementById('gotdClose').focus({ preventScroll: true });
        });
        try {
          sessionStorage.setItem('ta-gotd', today);
        } catch (e) { /* ignore */ }
      }, 1400);
    })();
  </script>

  <script>
    // Rotate the hero spotlight. Pauses for reduced motion / hidden tab.
    (() => {
      const spots = [...document.querySelectorAll('#spotBox .spot')];
      const dots = [...document.querySelectorAll('#spotDots button')];
      if (spots.length < 2) return;
      let cur = 0;
      let timer = 0;
      /* Non-first spotlight art is deferred (data-src in the markup) so the
         hero's initial load carries one image, not five; hydrate a spot
         just before it is shown, and prefetch the rest when idle. */
      const hydrate = (spot) => {
        const img = spot.querySelector('img[data-src]');
        if (img) {
          img.src = img.dataset.src;
          img.removeAttribute('data-src');
        }
      };
      const show = (n) => {
        spots[cur].classList.remove('active');
        spots[cur].setAttribute('aria-hidden', 'true');
        spots[cur].tabIndex = -1;
        dots[cur]?.classList.remove('on');
        cur = (n + spots.length) % spots.length;
        hydrate(spots[cur]);
        spots[cur].classList.add('active');
        spots[cur].setAttribute('aria-hidden', 'false');
        spots[cur].tabIndex = 0;
        dots[cur]?.classList.add('on');
      };
      const play = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = window.setInterval(() => show(cur + 1), 3600);
      };
      const stop = () => window.clearInterval(timer);
      dots.forEach((d, i) =>
        d.addEventListener('click', () => {
          stop();
          show(i);
          play();
        }),
      );
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
      play();
      const idle = window.requestIdleCallback || ((f) => window.setTimeout(f, 1800));
      idle(() => spots.forEach(hydrate));
    })();
  </script>
</Base>
