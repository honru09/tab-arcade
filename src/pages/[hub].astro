---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { hubs } from '../data/hubs.mjs';
import { shelves, allGames, u } from '../lib/games.mjs';
import { accentFor, bannerUrl } from '../lib/art.mjs';

export function getStaticPaths() {
  return hubs.map((hub) => ({ params: { hub: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const games = (shelves[hub.shelf] ? shelves[hub.shelf]() : allGames).slice(0, 48);
const accent = accentFor(games[0]);
const banner = bannerUrl(hub);
const heroBg = banner
  ? `background-image: linear-gradient(100deg, rgba(7,10,22,.95) 34%, rgba(7,10,22,.85) 68%, rgba(7,10,22,.68)), url(${banner});`
  : '';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: hub.h1,
    description: hub.metaDescription,
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: g.pageUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tabarcade.online/' },
      { '@type': 'ListItem', position: 2, name: hub.h1, item: `https://tabarcade.online/${hub.slug}/` },
    ],
  },
];
---

<Base title={hub.metaTitle} description={hub.metaDescription} jsonLd={jsonLd}>
  <div class:list={['hub-hero', { 'has-banner': !!banner }]} style={`--acc:${accent};${heroBg}`}>
    <h1>{hub.h1}</h1>
    <p class="tagline">{hub.tagline}</p>
  </div>

  {/* Client-side Jump back in rail (spec §2.1) */}
  <div id="jumpBackInRail"></div>

  <h2>Play Now — {games.length} Free Games</h2>
  <GameGrid games={games} />

  <div class="expandable" style="margin-top:30px">
    <div class="prose">
      <p>{hub.intro[0]}</p>
      <div class="exp-rest">
        <div class="exp-clip">
          {hub.intro.slice(1).map((p) => <p>{p}</p>)}
          <p>
            Every game above runs in a normal browser tab with no downloads or sign-ups, on Chromebooks,
            laptops and phones. Looking for something else? Browse the full
            <a href={u()}>TabArcade</a> catalog from the home page.
          </p>
        </div>
      </div>
    </div>
    <button class="exp-btn" type="button" aria-expanded="false" data-more="Read more ▾" data-less="Show less ▴">Read more ▾</button>
  </div>

  <script>
    (() => {
      // Jump back in rail (spec §2.1)
      try {
        const raw = localStorage.getItem('ta-recent');
        const list = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(list) || !list.length) return;
        const container = document.getElementById('jumpBackInRail');
        if (!container) return;
        const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const shelf = document.createElement('section');
        shelf.className = 'shelf jump-back-in-shelf';
        shelf.innerHTML = `
          <h2>🕒 Jump Back In</h2>
          <div class="tiles rail">
            ${list.slice(0, 8).map((item) => `
              <a class="tile" href="${esc(item.url)}" title="${esc(item.title)}" aria-label="Play ${esc(item.title)} online">
                <img class="tile-img" src="${esc(item.thumb)}" alt="" loading="lazy" width="512" height="384" />
                <span class="tile-cap">${esc(item.title)}</span>
              </a>
            `).join('')}
          </div>
        `;
        container.appendChild(shelf);
      } catch (e) {}
    })();
  </script>
</Base>
