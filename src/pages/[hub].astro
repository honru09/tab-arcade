---
import Base from '../layouts/Base.astro';
import GameGrid from '../components/GameGrid.astro';
import { hubs } from '../data/hubs.mjs';
import { shelves, allGames, gameUrl, u, MARQUEE_EXCLUDE, decodeEntities } from '../lib/games.mjs';

export function getStaticPaths() {
  return hubs.map((hub) => ({ params: { hub: hub.slug }, props: { hub } }));
}

const HUB_ICONS: Record<string, string> = {
  'unblocked-games-for-school': '🏫',
  'math-games': '🧮',
  'unblocked-games-for-chromebook': '💻',
  'classroom-games': '🎒',
  '2-player-games': '👥',
  'io-games': '🌐',
  'driving-games': '🏎️',
  'running-games': '🏃',
  'games-like-cool-math-games': '🧊',
  'best-unblocked-games': '⭐',
  'halloween-games': '🎃',
  'winter-games': '❄️',
};

const { hub } = Astro.props;
const pool = shelves[hub.shelf] ? shelves[hub.shelf]() : allGames;
const totalCount = pool.length;
let games = pool.slice(0, 48);
// MARQUEE_EXCLUDE cannot be hero tile (slot 0) per A9
if (games.length > 1 && MARQUEE_EXCLUDE.has(games[0].slug)) {
  const safeIdx = games.findIndex((g) => !MARQUEE_EXCLUDE.has(g.slug));
  if (safeIdx > 0) {
    const [fav] = games.splice(safeIdx, 1);
    games.unshift(fav);
  }
}

const cleanH1 = hub.h1.startsWith('Best ') ? hub.h1.slice(5) : hub.h1;
const q1Question = `What are the best ${cleanH1}?`;
const is2Player = hub.slug === '2-player-games' || hub.slug === '2-player-classroom-games';

const STOPLIST = new Set([
  '1 player', '2 player', '2 player games', '3d', '3d games', '2d',
  'fun', 'funny', 'cool', 'best', 'best games', 'hot', '2026 games', '2026',
  'boys', 'girls', 'android', 'mobile', 'webgl', 'html5', 'unity3d',
  'crazygamesunblocked', 'kids', 'amazing', 'mapi games', 'mapi',
  'free html5 games for your website',
  'action', 'arcade', 'casual',
]);

const TYPE_BLURBS: Record<string, string> = {
  '.io': 'Browser .io games — arenas, builders and quick rounds that load in a tab, no lobby codes.',
  'racing': 'Race against the clock or the pack — clean lines and sharp corners win.',
  'platform': 'Jump, climb and dodge through obstacle courses — timing beats speed.',
  'jumping': 'Jumping games built on timing — clear each gap or start the level again.',
  'adventure': 'Explore, collect and push forward through themed worlds and quests.',
  'multiplayer': 'Play against or alongside other players, on one keyboard or online.',
  'car': 'Car games — driving and parking challenges behind the wheel.',
  'driving': 'Driving games — steer, drift and park your way through traffic and tracks.',
  'simulation': 'Simulation games — run the job, from driving a truck to tending a farm.',
  'brain': 'Brain games — logic and memory challenges that reward thinking ahead.',
  'logic': 'Logic games — fixed rules, one right answer, and a chain of deductions to find it.',
  'puzzle': 'Puzzle games — match, sort and merge your way to a clear board.',
  'halloween': 'Halloween games — haunted mazes, zombie rounds and spooky-season chaos.',
  'monster': 'Monster games — creatures, chases and spooky showdowns.',
  'zombie': 'Zombie games — hold the line against the horde, round after round.',
  'animal': 'Animal games — creatures great and small, from ducks to dinosaurs.',
  'snow': 'Snow games — icy tracks, snowball runs and winter driving.',
};

// Group tags by a normalized key (lowercase, trailing " games" stripped)
// so near-duplicate feed tags (".io" / ".io Games") form one group, not two.
const normTag = (t: string) => t.toLowerCase().replace(/\s+games$/, '');
const tagCounts = new Map<string, number>();
const tagLabel = new Map<string, string>();
const tagFirstIndex = new Map<string, number>();
pool.forEach((game, idx) => {
  for (const key of new Set((game.tags || []).map(normTag))) {
    tagCounts.set(key, (tagCounts.get(key) || 0) + 1);
    if (!tagFirstIndex.has(key)) tagFirstIndex.set(key, idx);
  }
  for (const t of game.tags || []) {
    const key = normTag(t);
    const cur = tagLabel.get(key);
    if (!cur || t.length < cur.length) tagLabel.set(key, t);
  }
});

const qualifyingTags = [...tagCounts.entries()]
  .filter(([key, count]) => count >= 3 && !STOPLIST.has(key))
  .sort((a, b) => (b[1] !== a[1] ? b[1] - a[1] : (tagFirstIndex.get(a[0]) ?? 0) - (tagFirstIndex.get(b[0]) ?? 0)));

const topTags = qualifyingTags.slice(0, 3);
const typesGroups =
  topTags.length >= 2
    ? topTags.map(([key]) => ({
        tag: tagLabel.get(key) ?? key,
        blurb: TYPE_BLURBS[key] ?? null,
        games: pool.filter((g) => (g.tags || []).some((t) => normTag(t) === key)).slice(0, 3),
      }))
    : [];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: hub.h1,
    description: hub.metaDescription,
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: g.pageUrl,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: q1Question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Here are the first ${Math.min(5, games.length)} games on this shelf, in shelf order: ` + games.slice(0, 5).map((g) => g.title).join(', ') + '.',
        },
      },
      {
        '@type': 'Question',
        name: `How do you play ${hub.h1}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Pick a game from the shelf above and press play. Every game page explains the goal and the controls before you start.',
        },
      },
      ...(is2Player
        ? [
            {
              '@type': 'Question',
              name: 'Do 2 player games use one keyboard?',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'Some of them do — one player on WASD, the other on the arrow keys. Others take turns, race side by side, or play online. Every game page lists its own controls before you press play.',
              },
            },
          ]
        : []),
      {
        '@type': 'Question',
        name: `Do ${hub.h1} work on Chromebooks?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'These games open in a normal browser tab with no downloads and no sign-ups, and work on Chromebooks, laptops and phones.',
        },
      },
      {
        '@type': 'Question',
        name: `Do ${hub.h1} work on phones and tablets?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — these games run in a browser tab on phones and tablets too, with no app to install and no sign-up.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do I need to download or sign up?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No downloads and no sign-ups — play directly in a browser tab.',
        },
      },
      ...(hub.slug === 'io-games'
        ? [
            {
              '@type': 'Question',
              name: 'How do .io games work in multiplayer matches?',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'Some of them are. Online KitPvP pits you against real players, GORILGO FPS is an online shooter, and Ligmar Online is a shared-world MMORPG. The rest of this shelf is solo — merge puzzles, building and chopping games, obby escapes and a keyboard speed-run you play at your own pace.',
              },
            },
          ]
        : []),
      ...(hub.slug === 'driving-games'
        ? [
            {
              '@type': 'Question',
              name: 'How do I get better at driving games?',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'Practice one skill at a time: hold a slide in a drifter, then learn when to brake for a corner, then chase your best time. Every game page lists its controls before you press play, so you are never guessing which key does what.',
              },
            },
          ]
        : []),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tabarcade.online/' },
      { '@type': 'ListItem', position: 2, name: hub.h1, item: `https://tabarcade.online/${hub.slug}/` },
    ],
  },
];
---

<Base title={hub.metaTitle} description={hub.metaDescription} jsonLd={jsonLd} theme={hub.theme}>
  {/* Above the grid: ONLY shelf-style H1 header per Section 6 */}
  <h1 class="shelf-h1">
    <span class="shelf-icon">{HUB_ICONS[hub.slug] || '🎮'}</span>
    {hub.h1}
    <span class="shelf-count">{games.length} games</span>
  </h1>

  {/* Grid opens with 2x2 hero tile for the #1 game per Deliverable 3 */}
  <GameGrid games={games} hubHero={true} heroRibbon={hub.theme === 'halloween' ? '🎃 Halloween event' : null} />

  {totalCount > games.length && (
    <p class="shelf-note">Showing {games.length} of {totalCount} games on this shelf — <a href={u('all-games/')}>see the full A–Z list →</a></p>
  )}

  {/* LP1 (Poki): sibling-category cards relocated BELOW grid */}
  <nav class="sib-row" aria-label="More game categories">
    {hubs.filter((h) => h.slug !== hub.slug).map((h) => (
      <a class="sib-card" href={u(`${h.slug}/`)}>{h.h1}</a>
    ))}
  </nav>

  <section class="top-picks">
    <h2>Top picks in {hub.h1}</h2>
    <ol>
      {games.slice(0, 5).map((g) => {
        const desc = decodeEntities(g.description || '');
        const dot = desc.indexOf('. ');
        const cut = desc.slice(0, 150);
        const lastSpace = cut.lastIndexOf(' ');
        const hook =
          dot > 40 && dot <= 150
            ? desc.slice(0, dot + 1)
            : (lastSpace !== -1 ? cut.slice(0, lastSpace) : cut) + '…';
        return (
          <li>
            <a href={gameUrl(g)}>{g.title}</a>
            <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">{hook}</span>
          </li>
        );
      })}
    </ol>
    <p>First {Math.min(5, games.length)} games on this shelf, in shelf order.</p>
  </section>

  {hub.slug === 'driving-games' && (
    <section class="top-picks">
      <h3>Truck games</h3>
      <ol>
        <li>
          <a href={u('games/mud-truck-simulator-game/')}>Mud Truck Simulator Game</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Get ready for an exciting offroad driving adventure with Mud Truck Simulator Game! Take control of powerful trucks, drive through muddy roads,…</span>
        </li>
        <li>
          <a href={u('games/arctic-truck-driver/')}>Arctic Truck Driver</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Arctic Truck Driver is a realistic 3D ice road trucking game.</span>
        </li>
        <li>
          <a href={u('games/euro-truck-parking/')}>Euro Truck Parking</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Euro Truck Parking is an exciting truck-driving and parking simulation game where players take control of powerful heavy-duty trucks and put their…</span>
        </li>
        <li>
          <a href={u('games/monsters-wheels-2/')}>Monsters Wheels 2</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Monsters Wheels 2 is a monster truck game where every event asks something different.</span>
        </li>
      </ol>
    </section>
  )}

  {hub.slug === 'driving-games' && (
    <section class="top-picks">
      <h3>Parking games</h3>
      <ol>
        <li>
          <a href={u('games/midnight-valet/')}>Midnight Valet</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Midnight Valet is a 3D valet parking simulator.</span>
        </li>
        <li>
          <a href={u('games/euro-truck-parking/')}>Euro Truck Parking</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Euro Truck Parking is an exciting truck-driving and parking simulation game where players take control of powerful heavy-duty trucks and put their…</span>
        </li>
      </ol>
    </section>
  )}

  {hub.slug === 'games-like-cool-math-games' && (
    <section class="top-picks">
      <h3>Sorting games</h3>
      <ol>
        <li>
          <a href={u('games/sort-master-satisfeel-asmr/')}>Sort Master: Satisfeel ASMR</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Sort Master - Satisfeel ASMR is a relaxing puzzle game that combines item organization, satisfying sorting tasks, and calming ASMR moments.</span>
        </li>
        <li>
          <a href={u('games/color-sort-party/')}>Color Sort Party</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Have fun with this super-addictive game. Get to work: pour liquids between tubes, sort the colors and beat increasingly challenging levels. Use…</span>
        </li>
        <li>
          <a href={u('games/orbit-pals/')}>Orbit Pals</a>
          <span class="hook" style="display:block;color:var(--muted);font-size:14px;font-weight:400;margin-top:2px;">Orbit Pals is a cozy space sorting puzzle with adorable alien pals.</span>
        </li>
      </ol>
    </section>
  )}

  {hub.slug === 'games-like-cool-math-games' && (
    <section class="top-picks">
      <h3>Find your kind of logic game</h3>
      <p>Choose a game based on how you want to play — every row names a game on this shelf and what you actually do in it.</p>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>What you're looking for</th>
              <th>Game</th>
              <th>What you do</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sort colors into the right tubes</td>
              <td><a href={u('games/color-sort-party/')}>Color Sort Party</a></td>
              <td>Pour liquids between tubes, sort the colors, and beat the levels.</td>
            </tr>
            <tr>
              <td>Match three identical tiles</td>
              <td><a href={u('games/animals-brick/')}>Animals Brick</a></td>
              <td>Match three identical animal tiles to clear the board.</td>
            </tr>
            <tr>
              <td>Find hidden objects and escape</td>
              <td><a href={u('games/100-doors-mystery-room-escape/')}>100 Doors Mystery Room Escape</a></td>
              <td>Crack secret codes, solve logic puzzles and find hidden objects to escape each room.</td>
            </tr>
            <tr>
              <td>Match chips and clear the board</td>
              <td><a href={u('games/boombitz-bomb-chips/')}>BoomBitz: Bomb Chips</a></td>
              <td>Match colorful chips, trigger bomb blasts, and clear the board.</td>
            </tr>
            <tr>
              <td>Sort pals between planets</td>
              <td><a href={u('games/orbit-pals/')}>Orbit Pals</a></td>
              <td>Tap a planet to lift the pals, then tap another planet to make them hop over.</td>
            </tr>
            <tr>
              <td>Slide a rover through 48 rooms</td>
              <td><a href={u('games/core-rush/')}>CORE RUSH</a></td>
              <td>Launch your rover through 48 rooms, collect every core and reach the exit.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  )}

  {typesGroups.length >= 2 && (
    <section class="top-picks">
      <h2>Types of {hub.h1}</h2>
      {typesGroups.map((group) => (
        <div style="margin-top:16px;">
          <h3 style="font-size:16px;margin:0 0 8px;">{group.tag}</h3>
          {group.blurb && (
            <p style="color:var(--muted);font-size:14px;margin:0 0 8px;">{group.blurb}</p>
          )}
          <ol>
            {group.games.map((g) => (
              <li>
                <a href={gameUrl(g)}>{g.title}</a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  )}

  <h2>{hub.h1} FAQ</h2>
  <div class="faq">
    <details>
      <summary>{q1Question}</summary>
      <p set:html={`Here are the first ${Math.min(5, games.length)} games on this shelf, in shelf order: ` + games.slice(0, 5).map((g) => `<a href="${gameUrl(g)}">${g.title.replace(/&/g, '&amp;')}</a>`).join(', ') + '.'} />
    </details>
    <details>
      <summary>How do you play {hub.h1}?</summary>
      <p>
        Pick a game from the shelf above and press play. Every game page explains the goal and the controls before you start.
      </p>
    </details>
    {is2Player && (
      <details>
        <summary>Do 2 player games use one keyboard?</summary>
        <p>
          Some of them do — one player on WASD, the other on the arrow keys. Others take turns, race side by side, or play online. Every game page lists its own controls before you press play.
        </p>
      </details>
    )}
    <details>
      <summary>Do {hub.h1} work on Chromebooks?</summary>
      <p>
        These games open in a normal browser tab with no downloads and no sign-ups, and work on Chromebooks, laptops and phones.
      </p>
    </details>
    <details>
      <summary>Do {hub.h1} work on phones and tablets?</summary>
      <p>
        Yes — these games run in a browser tab on phones and tablets too, with no app to install and no sign-up.
      </p>
    </details>
    <details>
      <summary>Do I need to download or sign up?</summary>
      <p>
        No downloads and no sign-ups — play directly in a browser tab.
      </p>
    </details>
    {hub.slug === 'io-games' && (
      <details>
        <summary>How do .io games work in multiplayer matches?</summary>
        <p>
          Some of them are. Online KitPvP pits you against real players, GORILGO FPS is an online shooter, and Ligmar Online is a shared-world MMORPG. The rest of this shelf is solo — merge puzzles, building and chopping games, obby escapes and a keyboard speed-run you play at your own pace.
        </p>
      </details>
    )}
    {hub.slug === 'driving-games' && (
      <details>
        <summary>How do I get better at driving games?</summary>
        <p>
          Practice one skill at a time: hold a slide in a drifter, then learn when to brake for a corner, then chase your best time. Every game page lists its controls before you press play, so you are never guessing which key does what.
        </p>
      </details>
    )}
  </div>

  <nav class="explore-row" aria-label="Keep exploring" style="margin-top:24px;font-size:14px;line-height:1.6;">
    Keep exploring: {hubs.filter((h) => h.slug !== hub.slug).map((h, i, arr) => (
      <>
        <a href={u(`${h.slug}/`)}>{h.h1}</a>{i < arr.length - 1 ? ' · ' : ''}
      </>
    ))}
  </nav>

  {/* Tagline and intro copy relocated BELOW grid per Section 6 */}
  <div class="prose" style="margin-top:28px">
    <p class="hub-tagline"><strong>{hub.tagline}</strong></p>
    {hub.intro.map((p) => <p>{p}</p>)}
    <p>
      Every game above runs in a normal browser tab with no downloads or sign-ups, on Chromebooks,
      laptops and phones. Looking for something else? Browse the full
      <a href={u()}>TabArcade</a> catalog from the home page.
    </p>
  </div>

  {/* Client-side Jump back in rail (spec §2.1) */}
  <div id="jumpBackInRail"></div>

  <script>
    (() => {
      // Jump back in rail (spec §2.1)
      try {
        const raw = localStorage.getItem('ta-recent');
        const list = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(list) || !list.length) return;
        const container = document.getElementById('jumpBackInRail');
        if (!container) return;
        const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const isSparse = list.length <= 2;
        const shelf = document.createElement('section');
        shelf.className = `shelf jump-back-in-shelf${isSparse ? ' is-sparse' : ''}`;
        shelf.innerHTML = `
          <h2>🕒 Jump back in</h2>
          <div class="tiles rail${isSparse ? ' is-sparse' : ''}">
            ${list.slice(0, 8).map((item) => `
              <a class="tile" href="${esc(item.url)}" title="${esc(item.title)}" aria-label="Play ${esc(item.title)} online">
                <img class="tile-img" src="${esc(item.thumb)}" alt="" loading="lazy" width="512" height="384" onload="this.classList.add('is-loaded')" />
              </a>
            `).join('')}
          </div>
        `;
        container.appendChild(shelf);
      } catch (e) {}
    })();
  </script>
</Base>
