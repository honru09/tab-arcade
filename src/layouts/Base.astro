---
import { u } from '../lib/games.mjs';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, canonical, ogImage, jsonLd, noindex } = Astro.props;
const canon = canonical || new URL(Astro.url.pathname, Astro.site).href;
const og = ogImage || 'https://tabarcade.online/og.jpg';
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const nav = [
  ['Unblocked Games', u('unblocked-games-for-school/')],
  ['Classroom', u('classroom-games/')],
  ['Math', u('math-games/')],
  ['Driving', u('driving-games/')],
  ['Running', u('running-games/')],
  ['IO Games', u('io-games/')],
  ['2 Player', u('2-player-games/')],
  ['Best Games', u('best-unblocked-games/')],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canon} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={u('icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="icon" href={u('icon-512.png')} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    {/* Every page renders feed thumbnails from these two CDNs; warming the
        connections up front shaves a DNS+TLS round trip off the first cards
        and off the game-page poster (the LCP element there). */}
    <link rel="preconnect" href="https://img.gamedistribution.com" />
    <link rel="preconnect" href="https://img.gamemonetize.com" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TabArcade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canon} />}
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {
      ldList.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
    <noscript>
      <style>
        .drawer-body, .exp-rest { grid-template-rows: 1fr !important; }
        .exp-btn { display: none !important; }
        body .card { opacity: 1 !important; }
        .facade { display: none !important; }
      </style>
    </noscript>
    <style is:global>
      :root {
        --bg: #070a16;
        --panel: #101830;
        --panel2: #182242;
        --line: rgba(148, 178, 255, 0.16);
        --text: #f2f6ff;
        --muted: #9fb0cc;
        --amber: #ffb020;
        --cyan: #38e1ff;
        --violet: #8b5cf6;
        --pink: #ff5da2;
        --grad: linear-gradient(92deg, #ffd23e, #ff5da2 48%, #38e1ff);
        --disp: "Avenir Next", "Segoe UI", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.55;
        overflow-x: hidden;
      }
      /* Ambient neon backdrop: two soft glows + a faint blueprint grid. */
      body::before {
        content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background:
          radial-gradient(560px 340px at 12% -60px, rgba(139, 92, 246, 0.22), transparent 70%),
          radial-gradient(640px 380px at 88% -40px, rgba(56, 225, 255, 0.14), transparent 70%),
          radial-gradient(700px 500px at 50% 115%, rgba(255, 93, 162, 0.1), transparent 70%),
          linear-gradient(rgba(120, 160, 255, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(120, 160, 255, 0.045) 1px, transparent 1px);
        background-size: auto, auto, auto, 44px 44px, 44px 44px;
      }
      a { color: var(--cyan); text-decoration: none; }
      a:hover { text-decoration: underline; }
      :focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 6px; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }

      /* ---------- header ---------- */
      header.site {
        background: rgba(9, 13, 28, 0.82);
        -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        position: sticky; top: 0; z-index: 50;
      }
      header.site::after {
        content: ""; display: block; height: 2px; background: var(--grad); opacity: 0.85;
      }
      header.site .bar {
        display: flex; align-items: center; gap: 20px;
        padding-top: 10px; padding-bottom: 10px;
      }
      .logo {
        font-family: var(--disp); font-size: 24px; font-weight: 900; letter-spacing: -0.02em;
        color: var(--text); white-space: nowrap;
        display: inline-flex; align-items: center; gap: 9px;
      }
      .logo-mark { width: 30px; height: 30px; border-radius: 8px; display: block; flex: 0 0 auto; }
      .logo span { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .logo:hover { text-decoration: none; }
      nav.main {
        display: flex; gap: 4px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }
      nav.main::-webkit-scrollbar { display: none; }
      nav.main a {
        color: var(--muted); font-weight: 700; font-size: 14px; white-space: nowrap;
        padding: 7px 11px; border-radius: 999px; transition: color 0.2s, background 0.2s;
      }
      nav.main a:hover { color: var(--text); background: rgba(255, 255, 255, 0.07); text-decoration: none; }

      main { padding: 30px 0 54px; }
      h1 {
        font-family: var(--disp); font-size: clamp(26px, 4vw, 38px); font-weight: 900;
        letter-spacing: -0.02em; margin: 0 0 10px; line-height: 1.12;
      }
      h2 {
        font-family: var(--disp); font-size: clamp(20px, 2.6vw, 25px); font-weight: 800;
        letter-spacing: -0.01em; margin: 46px 0 16px; display: flex; align-items: center;
        gap: 11px; flex-wrap: wrap;
      }
      h2::before {
        content: ""; width: 5px; height: 0.92em; border-radius: 3px; background: var(--grad);
        flex: 0 0 auto;
      }
      h2 .more { font-size: 13.5px; font-weight: 700; margin-left: auto; }
      .lede { color: var(--muted); max-width: 760px; font-size: 16px; }
      .grad-text { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

      /* ---------- game cards ---------- */
      .grid {
        display: grid; gap: 18px;
        grid-template-columns: repeat(auto-fill, minmax(212px, 1fr));
      }
      @media (min-width: 900px) { .grid { gap: 21px; } }
      .card {
        --acc: var(--amber); --rx: 0deg; --ry: 0deg;
        position: relative; display: block; color: var(--text);
        border-radius: 20px; padding: 10px 10px 12px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
        border: 1px solid var(--line);
        transform: perspective(720px) rotateX(var(--rx)) rotateY(var(--ry));
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .card:hover, .card:focus-visible {
        text-decoration: none;
        border-color: rgba(255, 255, 255, 0.35);
        box-shadow: 0 22px 46px -14px rgba(0, 0, 0, 0.75), 0 10px 34px -6px var(--acc);
      }
      body.js-anim .card { opacity: 0; }
      body.js-anim .card.in { opacity: 1; animation: card-rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) backwards; animation-delay: var(--d, 0ms); }
      @keyframes card-rise {
        from { opacity: 0; transform: perspective(720px) translateY(18px) scale(0.97); }
        to { opacity: 1; }
      }
      .card-art { position: relative; display: block; border-radius: 14px; }
      .card-art::after {
        content: ""; position: absolute; inset: 6% -4% -6%; z-index: 0; border-radius: 50%;
        background: radial-gradient(closest-side, var(--acc), transparent);
        opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
      }
      .card:hover .card-art::after, .card:focus-visible .card-art::after { opacity: 0.4; }
      /* The frame: clips the Ken Burns / animated cover, carries the shadow
         and performs the hover breakout transform. */
      .thumb-wrap {
        position: relative; z-index: 1; display: block; border-radius: 14px; overflow: hidden;
        background: var(--panel2);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
        transition: transform 0.38s cubic-bezier(0.2, 0.7, 0.3, 1.45), box-shadow 0.38s ease;
      }
      .card:hover .thumb-wrap, .card:focus-visible .thumb-wrap {
        transform: scale(1.17) translateY(-9px) rotate(-1.6deg);
        box-shadow: 0 26px 34px -10px rgba(0, 0, 0, 0.7), 0 10px 22px -6px var(--acc);
      }
      .card-art .thumb {
        /* height:auto is load-bearing: with both width/height attributes
           present, Chromium treats the height attribute as a definite
           height and ignores aspect-ratio, stretching cards to 384px. */
        width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; display: block;
        transition: filter 0.38s ease;
      }
      .card:hover .thumb, .card:focus-visible .thumb { filter: saturate(1.18) brightness(1.05); }
      /* Ken Burns pan/zoom on the original thumbnail, hover/focus only.
         (The animated-cover swap that used to layer a generated loop over
         the thumb was retired in v5 — covers stay originals.) */
      .card:hover .thumb, .card:focus-visible .thumb {
        animation: kb 7s ease-in-out infinite alternate;
      }
      @keyframes kb {
        from { transform: scale(1.03) translate(0.6%, 0.4%); }
        to { transform: scale(1.16) translate(-1.8%, -2.2%); }
      }
      /* Speed-lines / particles shimmer layered over the cover. */
      .card-art .fx {
        position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0;
        mix-blend-mode: screen; transition: opacity 0.3s ease;
        background-image:
          repeating-linear-gradient(100deg, transparent 0 44px, rgba(255, 255, 255, 0.14) 44px 46px, transparent 46px 88px),
          radial-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1.7px);
        background-size: 240px 100%, 26px 26px;
      }
      .card:hover .fx, .card:focus-visible .fx {
        opacity: 1; animation: fx-move 1.5s linear infinite;
      }
      @keyframes fx-move {
        from { background-position: 0 0, 0 0; }
        to { background-position: -240px 0, 13px 26px; }
      }
      .ribbon {
        position: absolute; z-index: 4; top: 8px; left: 8px;
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 10.5px; font-weight: 900; letter-spacing: 0.09em;
        padding: 3.5px 8px; border-radius: 7px; color: #22112e;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.45);
      }
      .ribbon.hot { background: linear-gradient(92deg, #ffd23e, #ff5da2); }
      .ribbon.new { background: linear-gradient(92deg, #38e1ff, #4ade80); }
      .card-art .pop {
        position: absolute; z-index: 4; left: 50%; bottom: -3%;
        width: 90%; max-height: 124%; object-fit: contain; pointer-events: none;
        opacity: 0; transform: translate(-50%, 12%) scale(0.82);
        filter: drop-shadow(0 16px 16px rgba(0, 0, 0, 0.55));
        transition: opacity 0.35s ease, transform 0.42s cubic-bezier(0.2, 0.7, 0.3, 1.4);
      }
      .card:hover .pop, .card:focus-visible .pop {
        opacity: 1; transform: translate(-50%, -12%) scale(1.08);
      }
      .play-badge {
        position: absolute; z-index: 5; right: 8px; bottom: 8px;
        width: 38px; height: 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--grad); color: #131022; font-size: 14px; padding-left: 2px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
        opacity: 0; transform: translateY(6px) scale(0.8);
        transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.2, 0.7, 0.3, 1.5);
      }
      .card:hover .play-badge, .card:focus-visible .play-badge { opacity: 1; transform: none; }
      .card-meta { display: block; padding: 10px 4px 2px; }
      .card .t {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        font-weight: 800; font-size: 15px; line-height: 1.3; letter-spacing: -0.01em; min-height: 2.6em;
      }
      .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 7px; }
      .chip {
        display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.02em;
        color: var(--acc, #ffd9a0); background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px; padding: 2.5px 9px;
      }
      .chip.alt { background: transparent; color: var(--muted); border-color: var(--line); font-weight: 700; }
      .player-bar .chip, .hub-hero .chip { --acc: var(--amber); }

      /* ---------- rails (game page related) ---------- */
      @media (max-width: 760px) {
        .grid.rail {
          display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
          margin: 0 -16px; padding: 6px 16px 14px; scrollbar-width: none;
        }
        .grid.rail::-webkit-scrollbar { display: none; }
        .grid.rail .card { flex: 0 0 64%; scroll-snap-align: start; }
      }

      /* ---------- prose / faq / crumbs ---------- */
      .prose { max-width: 820px; color: #cdd8ee; }
      .prose p { margin: 0 0 14px; }
      .faq { max-width: 820px; }
      .faq details {
        background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line);
        border-radius: 14px; padding: 13px 17px; margin-bottom: 10px;
      }
      .faq summary { font-weight: 700; cursor: pointer; }
      .faq p { color: var(--muted); margin: 8px 0 2px; }
      .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 14px; }
      .crumbs a { color: var(--muted); font-weight: 600; }
      .crumbs a:hover { color: var(--text); }

      /* ---------- player stage ---------- */
      .stage { position: relative; margin-top: 20px; padding-top: 54px; }
      /* The frame carries the player's aspect ratio + height cap (moved off
         .player-shell) so key art anchors to the visible player box: the
         shell's width shrinks when max-height clamps, and art anchored to
         the full-width .stage floated in the gutter / bled off the poster.
         The padding-top band is reserved burst space — art overflows into
         it and can never reach the lede. The old .stage::before wash read
         as a muddy smear bar above the player; the accent now lives in a
         bounded plate behind the art. */
      .stage-frame { position: relative; max-height: 78vh; }
      .stage-frame.has-art::before {
        content: ""; position: absolute; z-index: 0; right: -16px; top: -64px;
        width: 240px; height: 240px; border-radius: 50%; pointer-events: none;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--acc, #ffb020) 38%, transparent), transparent 72%);
      }
      .stage-frame .player-shell { width: 100%; height: 100%; }
      .player-shell {
        position: relative; z-index: 1; background: #000;
        border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 18px; overflow: hidden;
        box-shadow: 0 30px 60px -18px rgba(0, 0, 0, 0.8);
      }
      .player-shell iframe { width: 100%; height: 100%; border: 0; display: block; }
      /* Click-to-play facade: poster + play button filling the shell until
         the real player iframe is injected on click (GROWTH §2.6). */
      .facade {
        position: absolute; inset: 0; width: 100%; height: 100%; display: block;
        padding: 0; border: 0; cursor: pointer; background: #000; color: var(--text);
        font: inherit; overflow: hidden;
      }
      .facade-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
      .facade-shade {
        position: absolute; inset: 0;
        background:
          linear-gradient(180deg, rgba(5, 8, 18, 0.1), rgba(5, 8, 18, 0.5) 78%),
          radial-gradient(440px 230px at 50% 112%, var(--acc, rgba(255, 176, 32, 0.4)), transparent 70%);
      }
      .facade-btn {
        position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%);
        width: 84px; height: 84px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--grad); color: #16102a; font-size: 29px; padding-left: 5px;
        box-shadow: 0 18px 40px -8px rgba(255, 93, 162, 0.7), 0 0 0 10px rgba(255, 255, 255, 0.08);
        transition: transform 0.2s ease;
      }
      .facade:hover .facade-btn, .facade:focus-visible .facade-btn { transform: translate(-50%, -50%) scale(1.09); }
      .facade-cap {
        position: absolute; left: 0; right: 0; bottom: 0; display: block;
        padding: 36px 16px 14px; text-align: center;
        background: linear-gradient(transparent, rgba(4, 6, 14, 0.74));
      }
      .facade-cap b {
        display: block; font-family: var(--disp); font-size: clamp(17px, 2.4vw, 22px);
        font-weight: 900; letter-spacing: -0.01em;
      }
      .facade-cap small { color: #c3cfe8; font-weight: 700; font-size: 12.5px; letter-spacing: 0.02em; }
      .stage-art {
        position: absolute; z-index: 3; right: 8px; top: -52px; width: 176px;
        max-height: 232px; object-fit: contain; pointer-events: none;
        filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.55));
        animation: floaty 5s ease-in-out infinite;
      }
      @keyframes floaty { 0%, 100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-9px) rotate(1deg); } }
      .player-bar {
        display: flex; justify-content: space-between; align-items: center; gap: 10px;
        padding: 12px 2px 0; flex-wrap: wrap;
      }
      .btn {
        background: var(--grad); color: #16102a; font-weight: 800; border: 0;
        border-radius: 999px; padding: 10px 20px; cursor: pointer; font-size: 14.5px;
        box-shadow: 0 10px 24px -8px rgba(255, 93, 162, 0.65);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .btn:hover { transform: translateY(-1px) scale(1.03); }
      .btn:active { transform: scale(0.97); }
      .btn.ghost {
        background: rgba(255, 255, 255, 0.06); color: var(--text);
        border: 1px solid var(--line); box-shadow: none;
      }
      .sticky-play {
        display: none; position: fixed; left: 10px; right: 10px; bottom: 10px; z-index: 60;
        align-items: center; gap: 10px; padding: 9px 9px 9px 15px; border-radius: 16px;
        background: rgba(13, 19, 40, 0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 16px 34px rgba(0, 0, 0, 0.55);
      }
      .sticky-play .sp-t { font-weight: 800; font-size: 14px; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      @media (max-width: 760px) {
        .sticky-play { display: flex; }
        body.has-sticky { padding-bottom: 74px; }
        .stage { padding-top: 40px; }
        .stage-art { width: 116px; top: -36px; right: 4px; max-height: 150px; }
        .stage-frame.has-art::before { width: 160px; height: 160px; top: -44px; right: -10px; }
        /* Live backdrop-blur over scrolling content is one of the most
           expensive effects on phone GPUs; go near-solid instead. */
        .sticky-play { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(13, 19, 40, 0.97); }
        .drawer { -webkit-backdrop-filter: none; backdrop-filter: none; }
        .spot .spot-name { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(8, 11, 24, 0.88); }
        .gotd { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(4, 6, 14, 0.8); }
      }

      /* ---------- hero (home) ---------- */
      .hero {
        position: relative; border-radius: 26px; overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background:
          radial-gradient(700px 340px at 85% -10%, rgba(139, 92, 246, 0.4), transparent 65%),
          radial-gradient(560px 300px at 8% 115%, rgba(56, 225, 255, 0.22), transparent 65%),
          linear-gradient(160deg, #131c3d, #0a0f24 62%);
        padding: clamp(22px, 4vw, 42px);
        display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 10px; align-items: center;
      }
      .hero::before {
        content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.07) 45%, transparent 60%);
        background-size: 250% 100%; animation: hero-shine 7s ease-in-out infinite;
      }
      @keyframes hero-shine { 0%, 100% { background-position: 120% 0; } 50% { background-position: -30% 0; } }
      /* Drifting aurora mesh behind the hero content. */
      .hero::after {
        content: ""; position: absolute; inset: -28%; z-index: 0; pointer-events: none;
        background:
          radial-gradient(360px 250px at 22% 30%, rgba(139, 92, 246, 0.34), transparent 70%),
          radial-gradient(400px 270px at 78% 64%, rgba(56, 225, 255, 0.25), transparent 70%),
          radial-gradient(300px 220px at 56% 12%, rgba(255, 93, 162, 0.22), transparent 70%);
        filter: blur(12px); animation: aurora 16s ease-in-out infinite alternate;
      }
      @keyframes aurora {
        from { transform: translate(-2.5%, -1.5%) scale(1); }
        to { transform: translate(2.5%, 2%) scale(1.07); }
      }
      .hero > div { position: relative; z-index: 1; }
      .hero h1 { font-size: clamp(30px, 4.8vw, 54px); line-height: 1.04; margin-bottom: 14px; }
      .hero .lede { font-size: clamp(15px, 1.6vw, 17.5px); max-width: 560px; }
      .hero-ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
      .hero-ctas .btn { font-size: 15.5px; padding: 12px 24px; }
      .hero-stats { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 24px; }
      .hero-stats .stat b {
        display: block; font-family: var(--disp); font-size: 21px; font-weight: 900; line-height: 1;
      }
      .hero-stats .stat span { font-size: 12px; color: var(--muted); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
      .hero-visual { position: relative; min-height: 300px; }
      .spot {
        position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
        justify-content: flex-end; opacity: 0; pointer-events: none; transform: translateY(14px) scale(0.96);
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
      }
      .spot.active { opacity: 1; pointer-events: auto; transform: none; }
      /* Accent plate behind the spotlight subject: the art used to float
         directly on the hero aurora and read washed-out. */
      .spot::before {
        content: ""; position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%);
        width: min(340px, 88%); aspect-ratio: 1; border-radius: 50%; pointer-events: none;
        background: radial-gradient(closest-side, color-mix(in srgb, var(--acc, #8b5cf6) 34%, transparent), transparent 72%);
      }
      .spot img {
        position: relative; z-index: 1;
        max-width: 92%; max-height: 252px; object-fit: contain;
        filter: drop-shadow(0 26px 26px rgba(0, 0, 0, 0.6));
        animation: floaty 5.5s ease-in-out infinite;
      }
      .spot .spot-name {
        margin-top: 6px; font-family: var(--disp); font-weight: 900; font-size: 17px; color: var(--text);
        background: rgba(8, 11, 24, 0.72); border: 1px solid rgba(255, 255, 255, 0.16);
        padding: 6px 16px; border-radius: 999px; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      }
      .spot:hover { text-decoration: none; }
      .spot-dots { display: flex; gap: 7px; justify-content: center; margin-top: 12px; }
      .spot-dots button {
        /* The visible dot stays 9px, but the clickable box grows to 25px
           via padding (background clipped to the content box) so the
           control meets minimum target-size guidance. */
        box-sizing: content-box; width: 9px; height: 9px; border-radius: 50%; border: 0;
        padding: 8px; background-clip: content-box; cursor: pointer;
        background-color: rgba(255, 255, 255, 0.25); transition: background-color 0.2s, transform 0.2s;
      }
      .spot-dots button.on { background-color: var(--amber); transform: scale(1.3); }
      @media (max-width: 820px) {
        /* Compact mobile hero (v5): same elements, much denser, so the
           first game row lands inside the first screen at 390x844. The
           spotlight art also gets a bigger share of the visual box — it
           used to render as a small dark shape in a tall empty area. */
        .hero { grid-template-columns: 1fr; padding: 18px 16px 12px; gap: 0; }
        .hero h1 { font-size: 27px; margin-bottom: 8px; }
        .hero .lede {
          font-size: 14.5px; line-height: 1.45;
          display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
        }
        .hero-ctas { margin-top: 13px; flex-wrap: nowrap; }
        .hero-ctas .btn { flex: 1; text-align: center; font-size: 13.5px; padding: 10px 8px; white-space: nowrap; }
        .hero-stats { margin-top: 13px; gap: 8px; flex-wrap: nowrap; justify-content: space-between; }
        .hero-stats .stat { flex: 1 1 0; min-width: 0; }
        .hero-stats .stat b { font-size: 17px; }
        .hero-stats .stat span { font-size: 10px; }
        .hero > div { min-width: 0; }
        .hero-visual { min-height: 198px; margin-top: 4px; }
        .spot img { max-height: 160px; max-width: 97%; }
        .spot .spot-name { font-size: 15px; margin-top: 2px; }
        .spot-dots { margin-top: 7px; }
        /* Static ambient layers on mobile: the aurora's blur(12px) +
           transform loop and the shine's background-position loop forced
           a full-hero repaint every frame on phone GPUs. */
        .hero::before { animation: none; }
        .hero::after { animation: none; filter: blur(6px); }
        .spot img, .stage-art, .gotd-art { animation: none; }
      }

      /* ---------- trending marquee ---------- */
      .marquee-band { margin-top: 20px; }
      .marquee-label {
        font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--muted); margin-bottom: 9px; display: flex; align-items: center; gap: 8px;
      }
      .marquee-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }
      .marquee {
        position: relative;
        overflow: hidden; border-radius: 16px;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
      }
      /* Belt-and-braces edge fades: WebKit can drop the mask on an element
         whose child is transform-animated, which left chips hard-clipped
         at the edges on iPhones. Gradient strips in the page background
         color fade them regardless. */
      .marquee::before, .marquee::after {
        content: ""; position: absolute; top: 0; bottom: 0; width: 30px; z-index: 2; pointer-events: none;
      }
      .marquee::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
      .marquee::after { right: 0; background: linear-gradient(-90deg, var(--bg), transparent); }
      .marquee-track {
        display: flex; gap: 10px; width: max-content; padding: 2px 0;
        animation: mq-scroll 46s linear infinite; will-change: transform;
      }
      .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
      @keyframes mq-scroll { to { transform: translateX(-50%); } }
      .mq-item {
        display: flex; align-items: center; gap: 9px; white-space: nowrap;
        background: rgba(255, 255, 255, 0.045); border: 1px solid var(--line);
        border-radius: 999px; padding: 5px 14px 5px 5px; color: var(--text);
        font-weight: 700; font-size: 13.5px; transition: border-color 0.2s, background 0.2s;
      }
      .mq-item:hover { text-decoration: none; border-color: rgba(255, 255, 255, 0.4); background: rgba(255, 255, 255, 0.09); }
      .mq-item img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; display: block; }

      /* ---------- hub hero band ---------- */
      .hub-hero {
        border-radius: 24px; padding: clamp(22px, 3.6vw, 38px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        background:
          radial-gradient(560px 240px at 90% -20%, var(--acc, rgba(139, 92, 246, 0.35)), transparent 65%),
          linear-gradient(160deg, #121a36, #0a0f24 65%);
        background-size: cover; background-position: center;
        margin-bottom: 8px;
      }
      .hub-hero.has-banner {
        background-blend-mode: normal;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 0 24px 44px -22px rgba(0, 0, 0, 0.8);
      }
      .hub-hero h1 { margin-bottom: 10px; }
      .hub-hero .tagline {
        font-size: clamp(15px, 1.8vw, 17.5px); font-weight: 600; color: #e6edff; max-width: 640px;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65);
      }
      .hub-hero.has-banner h1 { text-shadow: 0 3px 18px rgba(0, 0, 0, 0.7); }
      .hub-hero .prose { color: #c3d0ea; }

      /* ---------- drawers & expandables (progressive disclosure) ---------- */
      .teaser { color: var(--muted); max-width: 820px; font-size: 15.5px; margin: 20px 0 4px; }
      .teaser b { color: var(--text); }
      .drawers { display: grid; gap: 14px; margin: 16px 0 6px; max-width: 980px; }
      @media (min-width: 920px) { .drawers.two { grid-template-columns: 1fr 1fr; align-items: start; } }
      .drawer {
        border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.02));
        -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      }
      .drawer-head {
        width: 100%; display: flex; align-items: center; gap: 10px; text-align: left;
        background: none; border: 0; cursor: pointer; color: var(--text);
        font-family: var(--disp); font-size: 16.5px; font-weight: 800; letter-spacing: -0.01em;
        padding: 15px 18px;
      }
      .drawer-head .chev { margin-left: 8px; color: var(--muted); transition: transform 0.35s ease; flex: 0 0 auto; }
      .drawer-head .ctrl-chips { margin-left: auto; }
      .drawer.open .drawer-head .chev { transform: rotate(180deg); }
      .drawer-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.7, 0.3, 1); }
      .drawer.open .drawer-body { grid-template-rows: 1fr; }
      .drawer-inner { overflow: hidden; min-height: 0; }
      .drawer-inner .pad { padding: 2px 18px 17px; }
      .drawer-inner p { color: #cdd8ee; margin: 0 0 12px; font-size: 15px; }
      .drawer-inner p:last-child { margin-bottom: 0; }
      .ctrl-chips { display: flex; gap: 6px; flex-wrap: wrap; }
      .expandable .exp-rest { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.7, 0.3, 1); }
      .expandable.open .exp-rest { grid-template-rows: 1fr; }
      .expandable .exp-clip { overflow: hidden; min-height: 0; }
      .exp-btn {
        margin-top: 12px; background: rgba(255, 255, 255, 0.06); color: var(--text);
        border: 1px solid var(--line); border-radius: 999px; padding: 8px 18px;
        font-weight: 800; font-size: 13.5px; cursor: pointer; transition: background 0.2s, transform 0.15s;
      }
      .exp-btn:hover { background: rgba(255, 255, 255, 0.11); transform: translateY(-1px); }
      /* FAQ items join the same glass drawer family. */
      .faq details { transition: border-color 0.25s ease, background 0.25s ease; }
      .faq details[open ] { border-color: rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.06); }
      .faq summary { list-style: none; display: flex; align-items: center; gap: 8px; }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: "▾"; margin-left: auto; color: var(--muted); transition: transform 0.3s ease; }
      .faq details[open ] summary::after { transform: rotate(180deg); }

      /* ---------- game of the day modal ---------- */
      .gotd {
        position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center;
        padding: 18px; background: rgba(4, 6, 14, 0.68);
        -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
        opacity: 0; pointer-events: none; transition: opacity 0.35s ease;
      }
      .gotd.show { opacity: 1; pointer-events: auto; }
      .gotd-card {
        position: relative; width: min(430px, 100%); margin-top: 74px; text-align: center;
        border-radius: 26px; padding: 0 26px 24px;
        background: linear-gradient(165deg, #1a2547, #0b1024 72%);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.85), 0 0 60px -18px var(--acc, rgba(255, 176, 32, 0.55));
        transform: translateY(18px) scale(0.95); transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1.3);
      }
      .gotd.show .gotd-card { transform: none; }
      .gotd-art {
        width: 208px; height: 208px; object-fit: contain; margin: -86px auto 2px;
        filter: drop-shadow(0 22px 22px rgba(0, 0, 0, 0.6));
        animation: floaty 5s ease-in-out infinite;
      }
      /* The modal stays in the DOM after dismissal (opacity 0); without
         this, its art kept bobbing invisibly and forced a repaint of the
         modal layer every frame for the rest of the session — a real
         contributor to the mobile jank. Float only while shown. */
      .gotd:not(.show) .gotd-art { animation: none; }
      .gotd .kicker {
        display: inline-block; font-size: 11.5px; font-weight: 900; letter-spacing: 0.14em;
        color: #22112e; background: var(--grad); padding: 4.5px 12px; border-radius: 999px;
      }
      .gotd h3 { font-family: var(--disp); font-size: 26px; font-weight: 900; letter-spacing: -0.02em; margin: 12px 0 6px; }
      .gotd p { color: var(--muted); font-size: 14.5px; margin: 0 0 18px; }
      .gotd-close {
        position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; border-radius: 50%;
        border: 1px solid var(--line); background: rgba(255, 255, 255, 0.07); color: var(--text);
        font-size: 15px; cursor: pointer; line-height: 1;
      }
      .gotd-close:hover { background: rgba(255, 255, 255, 0.15); }
      @media (max-width: 640px) {
        .gotd-card { margin-top: 58px; padding: 0 18px 20px; }
        .gotd-art { width: 164px; height: 164px; margin-top: -70px; }
      }
      /* Placed after the component rules on purpose: the .gotd-art and
         .marquee base rules sit later in this stylesheet than the hero's
         <=820px block, so these mobile shutdowns are asserted here. The
         marquee's endless scroll of a ~4000px-wide track was a permanent
         repaint; on mobile it becomes a swipeable row (same chips, zero
         continuous cost). Desktop keeps the auto-scroll. */
      @media (max-width: 820px) {
        .gotd-art { animation: none; }
        .marquee { overflow-x: auto; scrollbar-width: none; }
        .marquee::-webkit-scrollbar { display: none; }
        .marquee-track { animation: none; }
      }

      /* ---------- 404 ---------- */
      .nf { text-align: center; padding: 12px 0 4px; }
      .nf img { width: min(340px, 72vw); border-radius: 24px; box-shadow: 0 30px 60px -18px rgba(0, 0, 0, 0.8); }
      .nf h1 { font-size: clamp(34px, 6vw, 58px); margin-top: 22px; }
      .nf .lede { margin: 0 auto; }
      .nf .hero-ctas { justify-content: center; }

      footer.site {
        border-top: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(9, 12, 26, 0.9));
        color: var(--muted); font-size: 13px; padding: 26px 0 34px; margin-top: 16px;
      }
      footer.site .links { display: flex; gap: 6px 16px; flex-wrap: wrap; margin-bottom: 12px; }
      footer.site .links a { color: var(--muted); font-weight: 600; }
      footer.site .links a:hover { color: var(--text); }

      @media (max-width: 640px) {
        header.site { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(9, 13, 28, 0.96); }
        header.site .bar { flex-wrap: wrap; gap: 6px 14px; padding-top: 8px; padding-bottom: 8px; }
        .logo { font-size: 22px; }
        .logo-mark { width: 26px; height: 26px; border-radius: 7px; }
        nav.main { order: 2; width: 100%; padding-bottom: 2px; }
        nav.main a { padding: 8px 11px; } /* ~37px tall tap targets */
        main { padding-top: 14px; }
        h2 { margin-top: 28px; }
        .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .card { border-radius: 16px; padding: 8px 8px 10px; }
        .card .t { font-size: 14px; }
        .play-badge { display: none; }
      }

      /* Touch devices (v5): the pop-out art, thumb breakout, Ken Burns and
         shimmer are hover flourishes. iOS Safari applies :hover on tap and
         leaves it stuck, which rendered the pop art statically, bursting
         over the section heading and the neighboring card. On devices
         that cannot hover, the art simply never appears and the cover
         stays the plain original thumbnail inside its own card. */
      @media (hover: none) {
        .card-art .pop { display: none; }
        .card:hover .thumb-wrap { transform: none; }
        .card:hover .thumb { filter: none; animation: none; }
        .card-art .fx { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        .marquee-track { animation: none; }
        body.js-anim .card { opacity: 1; }
        .card .thumb, .card-art .fx, .hero::after, .gotd-art { animation: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="logo" href={u()}><img class="logo-mark" src={u('favicon.svg')} alt="" width="30" height="30" />Tab<span>Arcade</span></a>
        <nav class="main">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <div class="links">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
          <a href={u('all-games/')}>All Games A–Z</a>
          <a href={u('unblocked-games-for-chromebook/')}>Chromebook Games</a>
          <a href={u('games-like-cool-math-games/')}>Games Like Cool Math Games</a>
        </div>
        <p>
          TabArcade collects free browser games that run in a normal tab — no downloads, no installs,
          no sign-ups. Every game works on Chromebooks, laptops and phones. Games are provided by
          their respective owners through licensed game feeds.
        </p>
        <p>© {new Date().getFullYear()} TabArcade. Play nice — and put the tab away when the bell rings.</p>
      </div>
    </footer>
    <script>
      // Entrance reveal + pointer-tracked 3D tilt. Transform/opacity only,
      // fine pointers only, and everything switches off for reduced motion.
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const cards = document.querySelectorAll('.card');
        if (!reduce && 'IntersectionObserver' in window) {
          document.body.classList.add('js-anim');
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -4% 0px' },
          );
          cards.forEach((c) => io.observe(c));
        }
        /* Drawers + "read more" expandables (progressive disclosure). */
        document.querySelectorAll('.drawer-head').forEach((btn) => {
          btn.addEventListener('click', () => {
            const d = btn.closest('.drawer');
            const open = d.classList.toggle('open');
            btn.setAttribute('aria-expanded', String(open));
          });
        });
        document.querySelectorAll('.exp-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const x = btn.closest('.expandable');
            const open = x.classList.toggle('open');
            btn.setAttribute('aria-expanded', String(open));
            btn.textContent = open ? btn.dataset.less : btn.dataset.more;
          });
        });

        /* Pop-out card art is a hover/focus flourish for devices that can
           hover: fetch it only when a card approaches the viewport instead
           of paying for every pop (100+ KB each) during the initial load.
           On touch devices it is never fetched or shown (see the
           hover:none CSS block) — the card keeps its original cover.
           (Animated cover loops were retired in v5: covers are always the
           original feed thumbnails now.) */
        const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (canHover) {
          const popIO =
            'IntersectionObserver' in window
              ? new IntersectionObserver(
                  (entries) => {
                    for (const e of entries) {
                      if (e.isIntersecting) {
                        e.target.src = e.target.dataset.pop;
                        popIO.unobserve(e.target);
                      }
                    }
                  },
                  { rootMargin: '600px 0px' },
                )
              : null;
          document.querySelectorAll('img.pop[data-pop]').forEach((img) => {
            if (popIO) popIO.observe(img);
            else img.src = img.dataset.pop;
          });
        }

        /* The trending marquee scrolls forever; pause it while it is off
           screen so it costs nothing during the rest of the page. */
        const mqTrack = document.querySelector('.marquee-track');
        if (mqTrack && 'IntersectionObserver' in window) {
          new IntersectionObserver(
            ([e]) => {
              mqTrack.style.animationPlayState = e.isIntersecting ? '' : 'paused';
            },
            { rootMargin: '80px' },
          ).observe(mqTrack);
        }

        if (!reduce && window.matchMedia('(pointer: fine)').matches) {
          document.querySelectorAll('[data-tilt]').forEach((el) => {
            let raf = 0;
            el.addEventListener('pointermove', (ev) => {
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const r = el.getBoundingClientRect();
                const x = (ev.clientX - r.left) / r.width - 0.5;
                const y = (ev.clientY - r.top) / r.height - 0.5;
                el.style.setProperty('--ry', (x * 9).toFixed(2) + 'deg');
                el.style.setProperty('--rx', (-y * 9).toFixed(2) + 'deg');
              });
            });
            el.addEventListener('pointerleave', () => {
              el.style.setProperty('--rx', '0deg');
              el.style.setProperty('--ry', '0deg');
            });
          });
        }
      })();
    </script>
  </body>
</html>
